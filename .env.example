# ==== Обязательные ====
# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Строка подключения к БД (SQLite + aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./data/news_detector.db

# Ключ авторизации GigaChat. ОБЯЗАТЕЛЬНО с префиксом "Basic ":
#   Basic MDE5ZDA1OGIt...  (сам секрет отдаётся без префикса, клиент добавит его сам)
GIGACHAT_AUTH_KEY=

# Область доступа OAuth (персональный API)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель для генерации саммари
GIGACHAT_MODEL=GigaChat-2-Max

# Проверять TLS-сертификат GigaChat (см. TODO в app/services/gigachat.py)
# false — выключено, т.к. у GigaChat собственный корневой CA.
# TODO(security): добавить корневой CA GigaChat в доверенные и выставить true.
GIGACHAT_VERIFY_SSL=false

# TODO(user): получить ключ на developers.sber.ru и подставить в GIGACHAT_AUTH_KEY

# Прокси для Telegram Bot API. Нужен, если api.telegram.org недоступен
# напрямую (например, из РФ). Поддерживаются http/https/socks5/socks5h.
# Примеры:
#   http://user:pass@host:port
#   socks5h://127.0.0.1:1080     (ssh -D 1080 -f -N user@server)
# Пустое значение = без прокси
#
# ВНИМАНИЕ: MTProto-прокси (ссылки tg://proxy?server=...) НЕ работают,
# бот общается с Telegram по HTTP и нужен именно HTTP/SOCKS5 прокси.
TELEGRAM_PROXY_URL=

# ==== Опциональные (используются значения по умолчанию) ====
# Интервал проверки публикаций (в минутах)
CHECK_INTERVAL_MINUTES=15

# API списка документов pravo.gov.ru (JSON; PeriodType: daily/weekly/monthly)
# Старое имя переменной RSS_FEED_URL всё ещё поддерживается как fallback.
PRAVO_API_URL=http://publication.pravo.gov.ru/api/Documents?PeriodType=daily

# Минимальная/максимальная длина саммари (в символах)
SUMMARY_MIN_LEN=140
SUMMARY_MAX_LEN=280

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ==== WebApp (Mini-App) для просмотра полного текста закона ====
# Адрес bind встроенного HTTP-сервера WebApp
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Публичный базовый URL WebApp — используется для кнопки «Полный текст» в
# сообщениях. Для production нужен HTTPS-домен (напр. https://app.example.com),
# для локальной разработки достаточно http://127.0.0.1:8080
# Пустое значение = кнопка «Полный текст» не показывается, остальной функционал работает
WEBAPP_URL=http://127.0.0.1:8080

# Админы с безлимитными саммари (для тестирования) — список chat_id через запятую
# Узнать свой chat_id: отправь боту /myid
# Пример: ADMIN_CHAT_IDS=123456789,987654321
ADMIN_CHAT_IDS=

# Обязательный Telegram-канал для гейта подписки новых пользователей.
# Numeric chat id (например -1001234567890) или @username канала.
# Пустое значение = гейт отключён, все пользователи считаются подписанными.
REQUIRED_CHANNEL_ID=
