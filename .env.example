# ==== Обязательные ====
# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Строка подключения к БД (SQLite + aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./data/news_detector.db

# Ключ авторизации GigaChat вида: Basic <секретный_код>
# Берётся в личном кабинете на developers.sber.ru (раздел "Ключи авторизации")
GIGACHAT_AUTH_KEY=

# Область доступа OAuth (персональный API)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель для генерации саммари
GIGACHAT_MODEL=GigaChat-2-Max

# Проверять TLS-сертификат GigaChat (см. TODO в app/services/gigachat.py)
# false — выключено, т.к. у GigaChat собственный корневой CA.
# TODO(security): добавить корневой CA GigaChat в доверенные и выставить true.
GIGACHAT_VERIFY_SSL=false

# TODO(user): получить ключ на developers.sber.ru и подставить в GIGACHAT_AUTH_KEY

# ==== Опциональные (используются значения по умолчанию) ====
# Интервал проверки RSS-ленты (в минутах)
CHECK_INTERVAL_MINUTES=15

# Минимальная/максимальная длина саммари (в символах)
SUMMARY_MIN_LEN=140
SUMMARY_MAX_LEN=280

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
